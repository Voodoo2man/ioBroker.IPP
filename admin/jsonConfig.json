{
    "i18n": true,
    "type": "panel",
    "items": {
        "printers": {
            "type": "accordion",
            "label": "Printers",
            "titleAttr": "id",
            "items": [
                { "attr": "id", "type": "text", "label": "ID", "xs": 12, "sm": 6 },
                { "attr": "label", "type": "text", "label": "Label", "xs": 12, "sm": 6 },
                { "attr": "host", "type": "text", "label": "Host", "xs": 12, "md": 8 },
                { "attr": "port", "type": "number", "label": "Port", "default": 631, "xs": 12, "md": 4 },
                { "attr": "basePath", "type": "text", "label": "IPP resource path", "default": "/ipp/print", "xs": 12 },
                { "attr": "ssl", "type": "checkbox", "label": "Use TLS", "xs": 12, "sm": 6 },
                { "attr": "verifySsl", "type": "checkbox", "label": "Verify TLS certificate", "default": false, "xs": 12, "sm": 6 }
            ],
            "xs": 12
        },
        "intervalSeconds": {
            "type": "number",
            "label": "Polling interval (seconds)",
            "default": 60,
            "min": 10,
            "max": 86400,
            "step": 1,
            "xs": 12,
            "sm": 6
        },
        "timeoutMs": {
            "type": "number",
            "label": "Request timeout (milliseconds)",
            "default": 5000,
            "min": 500,
            "max": 30000,
            "step": 500,
            "xs": 12,
            "sm": 6
        }
    }
}