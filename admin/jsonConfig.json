{
    "i18n": true,
    "type": "panel",
    "items": {
        "printers": {
            "type": "table",
            "label": "Printers",
            "items": [
                { "attr": "id", "type": "text", "title": "ID", "width": "15%" },
                { "attr": "label", "type": "text", "title": "Label", "width": "20%" },
                { "attr": "host", "type": "text", "title": "Host", "width": "25%" },
                { "attr": "port", "type": "number", "title": "Port", "width": "10%", "default": 631 },
                { "attr": "basePath", "type": "text", "title": "IPP resource path", "width": "15%", "default": "/ipp/print" },
                { "attr": "ssl", "type": "checkbox", "title": "Use TLS", "width": "10%" },
                { "attr": "verifySsl", "type": "checkbox", "title": "Verify TLS certificate", "width": "15%", "default": false }
            ],
            "xs": 12
        },
        "intervalSeconds": {
            "type": "number",
            "label": "Polling interval (seconds)",
            "default": 60,
            "min": 10,
            "max": 86400,
            "step": 1,
            "xs": 12,
            "sm": 6
        },
        "timeoutMs": {
            "type": "number",
            "label": "Request timeout (milliseconds)",
            "default": 5000,
            "min": 500,
            "max": 30000,
            "step": 500,
            "xs": 12,
            "sm": 6
        }
    }
}