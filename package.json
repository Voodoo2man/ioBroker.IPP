{
  "name": "iobroker.ipp",
  "version": "0.0.1",
  "description": "Read-only network printer monitoring over Internet Printing Protocol (IPP)",
  "author": {
    "name": "Voodoo2man",
    "email": "Voodoo2man@outlook.de"
  },
  "contributors": [],
  "homepage": "https://github.com/Voodoo2man/ioBroker.IPP",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "printer",
    "printing",
    "IPP",
    "IPP/2.0",
    "IPPS"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Voodoo2man/ioBroker.IPP.git"
  },
  "engines": {
    "node": ">= 24"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@sealsystems/ipp": "^2.11.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/iobroker": "npm:@iobroker/types@^7.2.5",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/main.js",
    "build/lib/printerConfig.js",
    "build/lib/printerIpp.js",
    "build/lib/printerState.js",
    "www/",
    "io-package.json",
    "LICENSE",
    "!build/io-package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:js": "npm run compile:test && mocha --exit \".test-build/lib/**/*.test.js\"",
    "test:package": "npm run build && npm run compile:test && mocha .test-build/test/package.js --exit",
    "test:integration": "npm run build && npm run compile:test && mocha .test-build/test/integration.js --exit",
    "compile:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/Voodoo2man/ioBroker.IPP/issues"
  },
  "readmeFilename": "README.md"
}
